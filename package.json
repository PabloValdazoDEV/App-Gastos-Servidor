{
  "name": "budget-app-servidor",
  "version": "0.1.0",
  "private": true,
  "description": "API de presupuesto, previsión y planificación económica de BudgetApp.",
  "type": "module",
  "engines": {
    "node": ">=20.18.3 <21 || >=22.12.0"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "nodemon app.js",
    "start": "node app.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "prisma db seed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcrypt": "6.0.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "jose": "6.1.0",
    "node-cron": "^4.2.1",
    "nodemailer": "9.0.5",
    "web-push": "^3.6.7",
    "zod": "4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "15.14.0",
    "nodemon": "3.1.10",
    "prisma": "6.12.0",
    "supertest": "7.1.4",
    "vitest": "3.2.7"
  }
}
