# ============================================
# APP
# ============================================

NODE_ENV=development
PORT=3000
APP_NAME=BudgetApp

SERVER_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# ============================================
# DATABASE
# ============================================

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# ============================================
# CORS
# Comma-separated exact browser origins. No wildcard is accepted.
# ============================================

CLIENT_ORIGINS=http://localhost:5173

# ============================================
# JWT
# Generate independent secrets with: openssl rand -base64 64
# ============================================

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ============================================
# COOKIES
# ============================================

AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ============================================
# CSRF
# Generate with: openssl rand -base64 64
# ============================================

CSRF_SECRET=
CSRF_COOKIE_NAME=csrf_token

# ============================================
# BCRYPT
# ============================================

BCRYPT_ROUNDS=12

# ============================================
# PRIVACY POLICY / REGISTRATION
# The server starts with these values empty, but new registrations remain
# disabled until the four mandatory public metadata fields are configured.
# Address and DPO email are optional. None of these values is secret.
# ============================================

PRIVACY_POLICY_VERSION=
PRIVACY_POLICY_EFFECTIVE_DATE=
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_CONTACT_EMAIL=
PRIVACY_CONTROLLER_ADDRESS=
PRIVACY_DPO_EMAIL=

# Invoice documents have fixed limits: 5 per invoice and 10 MiB per file.
# They use PostgreSQL storage and do not require credentials or feature flags.

# ============================================
# OPTIONAL FEATURE FLAGS
# Credentials become mandatory only when their feature is enabled.
# ============================================

GOOGLE_AUTH_ENABLED=false
EMAIL_ENABLED=false
WEB_PUSH_ENABLED=false

# ============================================
# GOOGLE OAUTH
# ============================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ============================================
# SMTP / EMAIL
# ============================================

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=
SMTP_PASS=

MAIL_FROM_NAME=BudgetApp
MAIL_FROM_ADDRESS=no-reply@example.com

# ============================================
# WEB PUSH
# ============================================

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ============================================
# JOBS / CRON
# ============================================

REMINDER_JOB_ENABLED=false
REMINDER_JOB_CRON=0 8 * * *

CRON_SECRET=

# ============================================
# SECURITY / RATE LIMIT
# ============================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Number of trusted reverse-proxy hops. Keep 0 when running directly.
TRUST_PROXY_HOPS=0

# ============================================
# PASSWORD RESET
# ============================================

PASSWORD_RESET_TTL_MINUTES=30

# ============================================
# INVITATIONS
# ============================================

INVITATION_TTL_DAYS=7

# ============================================
# DEFAULT APP CONFIG
# ============================================

DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_LOCALE=es-ES
DEFAULT_CURRENCY=EUR

DEFAULT_SAFETY_MARGIN_PERCENT=10

DEFAULT_CONTRIBUTION_DAY=1

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=info
